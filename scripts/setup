#!/usr/bin/env zsh
# One-time setup (safe to re-run): dependencies, speech models, browser assets.
# Needs bun and uv. Everything downloaded lands in ~/.handfree/models or
# daemon/public/vendor; nothing runs as a system service.

set -euo pipefail
ROOT=${0:A:h:h}
MODELS=${HANDFREE_HOME:-$HOME/.handfree}/models
VENDOR=$ROOT/daemon/public/vendor

command -v bun >/dev/null || { echo "setup: install bun first (https://bun.sh)" >&2; exit 1; }
command -v uv  >/dev/null || { echo "setup: install uv first (https://docs.astral.sh/uv/)" >&2; exit 1; }

# tmux runs the sessions you start from the phone (a Mac with no screen needs no terminal)
if ! command -v tmux >/dev/null; then
  if command -v brew >/dev/null; then echo "== tmux"; brew install --quiet tmux
  else echo "setup: tmux not found; install it to start sessions from the phone" >&2; fi
fi

echo "== bun packages"
(cd "$ROOT/channel" && bun install --silent)
(cd "$ROOT/daemon" && bun install --silent)

echo "== python speech sidecar"
(cd "$ROOT/speech" && uv sync --python 3.12 --quiet)

fetch() { # url dest
  [[ -s "$2" ]] && return 0
  echo "   downloading $(basename "$2")"
  curl -fL --retry 3 -sS -o "$2.part" "$1" && mv "$2.part" "$2"
}

echo "== speech models -> $MODELS"
mkdir -p "$MODELS"
fetch https://huggingface.co/ggerganov/whisper.cpp/resolve/main/ggml-large-v3-turbo-q8_0.bin "$MODELS/ggml-large-v3-turbo-q8_0.bin"
fetch https://github.com/thewh1teagle/kokoro-onnx/releases/download/model-files-v1.0/kokoro-v1.0.onnx "$MODELS/kokoro-v1.0.onnx"
fetch https://github.com/thewh1teagle/kokoro-onnx/releases/download/model-files-v1.0/voices-v1.0.bin "$MODELS/voices-v1.0.bin"
fetch https://cdn.jsdelivr.net/npm/@ricky0123/vad-web@0.0.29/dist/silero_vad_v5.onnx "$MODELS/silero_vad_v5.onnx"
fetch https://huggingface.co/pipecat-ai/smart-turn-v3/resolve/main/smart-turn-v3.2-cpu.onnx "$MODELS/smart-turn-v3.2-cpu.onnx"
# "my voice only": a speaker model (WeSpeaker ResNet34, VoxCeleb), ~26 MB
fetch https://github.com/k2-fsa/sherpa-onnx/releases/download/speaker-recongition-models/wespeaker_en_voxceleb_resnet34_LM.onnx "$MODELS/wespeaker_resnet34.onnx"

echo "== browser assets -> $VENDOR"
mkdir -p "$VENDOR"
fetch https://cdn.jsdelivr.net/npm/marked@12.0.2/marked.min.js "$VENDOR/marked.min.js"
fetch https://cdn.jsdelivr.net/npm/dompurify@3.1.6/dist/purify.min.js "$VENDOR/purify.min.js"
fetch https://cdn.jsdelivr.net/npm/mermaid@10.9.1/dist/mermaid.min.js "$VENDOR/mermaid.min.js"
# Halo (hand gestures from the camera): MediaPipe's gesture model, run in the browser
fetch https://cdn.jsdelivr.net/npm/@mediapipe/tasks-vision@0.10.14/vision_bundle.mjs "$VENDOR/vision_bundle.mjs"
fetch https://cdn.jsdelivr.net/npm/@mediapipe/tasks-vision@0.10.14/wasm/vision_wasm_internal.js "$VENDOR/vision_wasm_internal.js"
fetch https://cdn.jsdelivr.net/npm/@mediapipe/tasks-vision@0.10.14/wasm/vision_wasm_internal.wasm "$VENDOR/vision_wasm_internal.wasm"
fetch https://storage.googleapis.com/mediapipe-models/gesture_recognizer/gesture_recognizer/float16/1/gesture_recognizer.task "$VENDOR/gesture_recognizer.task"

echo "== done. Start a voice session with: $ROOT/scripts/claude-voice"
